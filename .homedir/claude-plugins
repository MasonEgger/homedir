#!/usr/bin/env -S uv run --script
# ABOUTME: Install or update Claude Code plugins from multiple marketplaces.
# Ensures marketplaces are configured, then installs/updates each plugin.

# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///

"""Install or update Claude Code plugins from multiple marketplaces."""

import platform
import re
import subprocess

FRESH_INSTALL_RE = re.compile(r"already installed", re.IGNORECASE)
# `claude plugin list` renders each install record as "❯ name@marketplace"
# followed by "Version: X" and "Scope: user|project|local" lines.
LIST_NAME_RE = re.compile(r"❯\s+(\S+)")
LIST_VERSION_RE = re.compile(r"Version:\s*(.+)")
LIST_SCOPE_RE = re.compile(r"Scope:\s*(\S+)")

MARKETPLACES: list[tuple[str, str]] = [
    # (name, github_repo)
    ("anthropic-agent-skills", "anthropics/skills"),
    ("claude-plugins-official", "anthropics/claude-plugins-official"),
    ("bpe", "MasonEgger/bpe-claude-code-plugin"),
    ("mmegger-private-plugins", "MasonEgger/claude-code-plugin-private"),
    ("obsidian-skills", "kepano/obsidian-skills"),
    ("slidev-plugins", "slidevjs/slidev"),
    ("temporal-marketplace", "temporalio/claude-temporal-plugin"),
]

PLUGINS: list[tuple[str, str]] = [
    # (plugin_name, marketplace)
    ("frontend-design", "claude-plugins-official"),
    ("plugin-dev", "claude-plugins-official"),
    ("skill-creator", "claude-plugins-official"),
    ("bpe", "bpe"),
    ("content-design", "mmegger-private-plugins"),
    ("health", "mmegger-private-plugins"),
    ("indie", "mmegger-private-plugins"),
    ("productivity", "mmegger-private-plugins"),
    ("python", "mmegger-private-plugins"),
    ("document-skills", "anthropic-agent-skills"),
    ("example-skills", "anthropic-agent-skills"),
    ("obsidian", "obsidian-skills"),
    ("slidev", "slidev-plugins"),
    ("temporal", "temporal-marketplace"),
]

DEV_ONLY_PLUGINS: list[tuple[str, str]] = [
    # Guarded plugins that must never land on the work machine. The
    # metacognition plugin is the private taste-extraction factory; for now
    # "is this a Mac" is the work-machine test, so Darwin skips the install
    # and removes any stray copy. Revisit the test if a Mac ever becomes a
    # dev box.
    ("metacognition", "mmegger-private-plugins"),
]


def is_work_machine() -> bool:
    """Return True on the work machine (currently: any Mac)."""
    return platform.system() == "Darwin"


STALE_PLUGINS: list[str] = [
    # Superseded installs to remove if present. bpe re-keyed when its
    # marketplace renamed from mmegger-plugins to bpe (2026-07-28); python
    # moved to the private marketplace (v2.0.0, 2026-07); productivity and
    # writing left the public repo long ago but were never uninstalled.
    "bpe@mmegger-plugins",
    "python@mmegger-plugins",
    "productivity@mmegger-plugins",
    "writing@mmegger-plugins",
    # Unused after a 2026-08-08 /doctor pass: zero invocations in 43 sessions
    # over 29 days. example-skills kept (claude-api and the doc/design skills);
    # obsidian kept (productivity depends on it). Re-add to PLUGINS to restore.
    "asana@claude-plugins-official",
    "discord@claude-plugins-official",
    "playground@claude-plugins-official",
    "playwright@claude-plugins-official",
    "slack@claude-plugins-official",
    "telegram@claude-plugins-official",
]

STALE_MARKETPLACES: list[str] = [
    # Registrations superseded by a rename; removed after their stale
    # plugins are uninstalled. mmegger-plugins became bpe (2026-07-28).
    "mmegger-plugins",
]


def run_claude(args: list[str]) -> subprocess.CompletedProcess[str]:
    """Run a claude CLI command and return the result."""
    return subprocess.run(
        ["claude", *args],
        capture_output=True,
        text=True,
        check=False,  # callers branch on returncode
    )


def ensure_marketplaces() -> bool:
    """Ensure all required marketplaces are configured. Return False on failure."""
    ok = True
    for name, repo in MARKETPLACES:
        print(f"Ensuring marketplace {name}...", end=" ", flush=True)
        result = run_claude(["plugin", "marketplace", "add", repo])
        if result.returncode != 0:
            print(f"FAILED: {result.stderr.strip() or result.stdout.strip()}")
            ok = False
        else:
            print("ok")
    return ok


def installed_versions() -> dict[str, str]:
    """Map qualified plugin name to its user-scope installed version.

    `claude plugin list` prints one record per install, and a plugin can be
    installed at several scopes at once. Only the user-scope record counts
    here; a stale project-scope record once shadowed the real version in
    this report because the old parser kept whichever record came last.
    """
    result = run_claude(["plugin", "list"])
    versions: dict[str, str] = {}
    current: str | None = None
    version: str | None = None
    for line in f"{result.stdout}\n{result.stderr}".splitlines():
        name_match = LIST_NAME_RE.search(line)
        if name_match:
            current, version = name_match.group(1), None
            continue
        version_match = LIST_VERSION_RE.search(line)
        if version_match and current:
            version = version_match.group(1).strip()
            continue
        scope_match = LIST_SCOPE_RE.search(line)
        if scope_match and current:
            if scope_match.group(1) == "user" and version:
                versions[current] = version
            current, version = None, None
    return versions


def audit_scopes() -> None:
    """Warn about non-user-scope install records.

    Everything is meant to be installed once, globally, at user scope.
    Project- and local-scope records come from sessions that ran
    `claude plugin install` with a narrower scope (or from a checked-in
    settings file enabling plugins per-project); they pin stale versions
    and shadow nothing useful. Surface them so they get removed instead
    of rotting silently, the way twelve of them did between 2026-08-23
    and 2026-09-20.
    """
    result = run_claude(["plugin", "list"])
    current: str | None = None
    strays: list[tuple[str, str]] = []
    for line in f"{result.stdout}\n{result.stderr}".splitlines():
        name_match = LIST_NAME_RE.search(line)
        if name_match:
            current = name_match.group(1)
            continue
        scope_match = LIST_SCOPE_RE.search(line)
        if scope_match and current and scope_match.group(1) != "user":
            strays.append((current, scope_match.group(1)))
            current = None
    if strays:
        print("\n⚠️  Non-user-scope installs detected (stale, remove them):")
        for name, scope in strays:
            print(f"   {name} at {scope} scope")
            print(f"   fix: claude plugin uninstall --scope {scope} {name}")
        print("   (run the uninstall from the project directory that owns the record)")


def show_version(version: str | None) -> str:
    """Render a version for display, hiding the marketplace's `unknown` sentinel."""
    return f" {version}" if version and version != "unknown" else ""


def remove_stale_marketplaces() -> None:
    """Deregister renamed marketplaces; one that is not registered is silent."""
    for name in STALE_MARKETPLACES:
        result = run_claude(["plugin", "marketplace", "remove", name])
        if result.returncode == 0:
            print(f"🗑️ marketplace {name}: removed (renamed)")


def remove_stale_plugins() -> None:
    """Uninstall superseded plugins; a plugin that is not installed is silent.

    Runs before sync so a plugin migrating between marketplaces (same plugin
    name, new home) never has two installs competing for the same commands.
    On the work machine the dev-only plugins join the removal pass, so a
    guarded plugin that ever leaks onto it is cleaned up on the next sync.
    """
    stale = list(STALE_PLUGINS)
    if is_work_machine():
        stale.extend(f"{plugin}@{marketplace}" for plugin, marketplace in DEV_ONLY_PLUGINS)
    for qualified in stale:
        result = run_claude(["plugin", "uninstall", qualified])
        if result.returncode == 0:
            print(f"🗑️ {qualified}: uninstalled (superseded or guarded)")


def active_plugins() -> list[tuple[str, str]]:
    """The plugin set for this machine: everything, minus guarded on work."""
    if is_work_machine():
        return PLUGINS
    return PLUGINS + DEV_ONLY_PLUGINS


def sync_plugins() -> None:
    """Install/update each plugin, then report version changes.

    The verdict comes from comparing the installed version before and after,
    not from the `claude plugin update` message. That message is unreliable:
    plugins the marketplace leaves unversioned (Version: unknown) are re-pulled
    on every run and always print "refreshed from source", which would otherwise
    read as a spurious update on every invocation.
    """
    plugins = active_plugins()
    before = installed_versions()
    failures: dict[str, str] = {}
    freshly: set[str] = set()

    print("Syncing plugins", end="", flush=True)
    for plugin, marketplace in plugins:
        qualified = f"{plugin}@{marketplace}"
        # install is idempotent; it succeeds even if already installed.
        # --scope user is explicit so a cwd inside a project can never
        # create a project-scope install.
        install_result = run_claude(
            ["plugin", "install", "--scope", "user", qualified]
        )
        if install_result.returncode != 0:
            failures[qualified] = (
                install_result.stderr.strip() or install_result.stdout.strip()
            )
            print("x", end="", flush=True)
            continue
        install_output = f"{install_result.stdout}\n{install_result.stderr}"
        if not FRESH_INSTALL_RE.search(install_output):
            freshly.add(qualified)
        # update to latest version
        update_result = run_claude(
            ["plugin", "update", "--scope", "user", qualified]
        )
        if update_result.returncode != 0:
            failures[qualified] = (
                "update failed: "
                f"{update_result.stderr.strip() or update_result.stdout.strip()}"
            )
            print("x", end="", flush=True)
            continue
        print(".", end="", flush=True)
    print()

    after = installed_versions()
    for plugin, marketplace in plugins:
        qualified = f"{plugin}@{marketplace}"
        label = f"{plugin} ({marketplace})"
        old, new = before.get(qualified), after.get(qualified)
        if qualified in failures:
            print(f"❌ {label}: {failures[qualified]}")
        elif qualified in freshly:
            print(f"🆕 {label}: installed{show_version(new)}")
        elif old and new and old != new:
            print(f"🚧 {label}: updated {old} -> {new}")
        elif new and new != "unknown":
            print(f"✓ {label}: up to date {new}")
        else:
            print(f"🔄 {label}: refreshed from source (unversioned)")
    if is_work_machine():
        for plugin, marketplace in DEV_ONLY_PLUGINS:
            print(f"⏭️ {plugin} ({marketplace}): skipped (guarded, dev-box only)")


def main() -> None:
    """Entry point."""
    if not ensure_marketplaces():
        print(
            "\nMarketplace setup had errors. Continuing with available marketplaces...\n"
        )

    remove_stale_plugins()
    remove_stale_marketplaces()
    sync_plugins()
    audit_scopes()
    print("\nRun /reload-plugins in Claude Code to activate changes.")


if __name__ == "__main__":
    main()
